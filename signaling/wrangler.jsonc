{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "screenguideqi-signaling",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-11",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "ASSIST_HUB", "class_name": "AssistHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AssistHub"] }],
  "observability": { "enabled": false }
}
